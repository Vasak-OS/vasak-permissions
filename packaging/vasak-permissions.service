[Unit]
Description=VasakOS permission service
Documentation=https://github.com/Vasak-OS/vasak-permissions
# polkit answers the management calls; without it those would fail.
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=exec
ExecStart=/usr/bin/vasak-permissions
Restart=on-failure
RestartSec=2

# Root is needed to read /proc/<pid>/exe of other users' processes and to own
# the policy files. Everything not needed for that is taken away.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=vasak-permissions
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
# El servicio sigue el registro del kernel para avisar de lo que los perfiles de
# AppArmor bloquean. `PrivateDevices` le da un /dev propio donde ese archivo no
# existe —comprobado: queda null, zero, random y poco más—, así que se monta el
# único que hace falta, y de sólo lectura.
#
# Con el `-` delante para que el servicio arranque igual en un kernel sin él.
BindReadOnlyPaths=-/dev/kmsg
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
