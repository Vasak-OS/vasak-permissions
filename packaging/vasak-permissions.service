[Unit]
Description=VasakOS permission service
Documentation=https://github.com/Vasak-OS/vasak-permissions
# polkit answers the management calls; without it those would fail.
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=exec
ExecStart=/usr/bin/vasak-permissions
Restart=on-failure
RestartSec=2

# Root is needed to read /proc/<pid>/exe of other users' processes and to own
# the policy files. Everything not needed for that is taken away.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=vasak-permissions
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
