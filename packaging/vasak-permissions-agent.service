[Unit]
Description=VasakOS permission dialog agent
Documentation=https://github.com/Vasak-OS/vasak-permissions
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# `dbus` y no `exec`: este proceso es el backend de portal de
# `org.freedesktop.impl.portal.Access`, y `xdg-desktop-portal` no termina de
# arrancar hasta que ese nombre existe. Con `Type=exec` systemd daba la unidad
# por arrancada a los 82 ms —cuando el binario hacía exec— mientras el nombre no
# aparecía hasta quince segundos después, así que el plantón que eso causaba en
# cada inicio de sesión no figuraba en ningún lado: `systemd-analyze --user
# blame` mostraba 82 ms.
#
# Ahora «arrancada» quiere decir lo que dice. Si el nombre no se puede tomar la
# unidad falla y `Restart=on-failure` la vuelve a intentar, que es lo correcto:
# un agente sin su backend de portal está a medias, y el caso en que pasa —una
# instancia anterior todavía soltando el nombre— se arregla solo al reintentar.
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.vasak
ExecStart=/usr/bin/vasak-permissions-agent
Restart=on-failure
RestartSec=2

# Este es el proceso que **otorga** permisos: el diálogo donde decís que sí o
# que no a la cámara, al micrófono o a una cuenta. Todo el modelo de seguridad
# del servicio descansa en que sea el único /usr/bin/vasak-permissions-agent
# —por eso el binario está en una ruta que necesita root para escribirse—.
#
# # Por qué este proceso no puede llevar seccomp
#
# El agente dibuja un diálogo Tauri (GTK3 + WebKit). GTK carga los íconos de los
# botones de la ventana (`window-minimize/maximize/close-symbolic`, SVG) con
# gdk-pixbuf → glycin, que aísla cada decodificación en un `bwrap` anidado. Ese
# bwrap **no arranca si el proceso lleva un filtro seccomp**: no puede armar su
# espacio de nombres de montaje —devuelve EPERM en «Failed to make / slave»—, la
# carga del ícono falla y GTK la trata como **fatal** (`Bail out!`). El agente se
# caía al abrir el diálogo, y sin diálogo no se puede conceder ningún permiso. Las
# demás aplicaciones del escritorio cargan los mismos íconos bien porque no corren
# con este endurecimiento. Es un bug de upstream (glycin + WebKitGTK + GTK);
# mientras no se arregle arriba, este proceso no puede filtrar syscalls.
#
# Comprobado en vivo: con cualquier directiva que instale un filtro seccomp el
# bwrap de glycin falla y el diálogo se cae; sin ellas se dibuja y responde. Por
# eso quedan afuera las que **instalan seccomp**: SystemCallFilter,
# SystemCallArchitectures, SystemCallErrorNumber, LockPersonality, RestrictRealtime,
# RestrictSUIDSGID, RestrictAddressFamilies, ProtectClock, ProtectKernelLogs y
# ProtectKernelModules.
#
# Se **mantiene** todo el aislamiento que NO usa seccomp, que es lo que de verdad
# contiene a este proceso: no escala privilegios (NoNewPrivileges), no tiene
# capabilities, el sistema es de sólo lectura (ProtectSystem), `/tmp` y `/dev` son
# propios —de /dev sólo la placa de video, para dibujar—, `/proc` queda oculto
# (ProtectProc) y se conservan las protecciones de montaje/UTS que NO son seccomp:
# ProtectHostname, ProtectKernelTunables y ProtectControlGroups. La pérdida real es
# el filtro de syscalls y las protecciones de kernel basadas en seccomp; a cambio,
# el diálogo de permisos vuelve a funcionar.
#
# El **daemon** —que aplica y guarda la política— conserva todo su endurecimiento;
# esto relaja sólo el proceso de la UI que propone. Re-endurecer cuando glycin/GTK
# decodifiquen íconos bajo seccomp (Vasak-OS/vasak-permissions#100).
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=full
ProtectProc=invisible
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
PrivateDevices=yes
BindPaths=-/dev/dri

[Install]
WantedBy=graphical-session.target
