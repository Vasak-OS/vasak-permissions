[Unit]
Description=VasakOS permission dialog agent
Documentation=https://github.com/Vasak-OS/vasak-permissions
PartOf=graphical-session.target
After=graphical-session.target

[Service]
# `dbus` y no `exec`: este proceso es el backend de portal de
# `org.freedesktop.impl.portal.Access`, y `xdg-desktop-portal` no termina de
# arrancar hasta que ese nombre existe. Con `Type=exec` systemd daba la unidad
# por arrancada a los 82 ms —cuando el binario hacía exec— mientras el nombre no
# aparecía hasta quince segundos después, así que el plantón que eso causaba en
# cada inicio de sesión no figuraba en ningún lado: `systemd-analyze --user
# blame` mostraba 82 ms.
#
# Ahora «arrancada» quiere decir lo que dice. Si el nombre no se puede tomar la
# unidad falla y `Restart=on-failure` la vuelve a intentar, que es lo correcto:
# un agente sin su backend de portal está a medias, y el caso en que pasa —una
# instancia anterior todavía soltando el nombre— se arregla solo al reintentar.
Type=dbus
BusName=org.freedesktop.impl.portal.desktop.vasak
ExecStart=/usr/bin/vasak-permissions-agent
Restart=on-failure
RestartSec=2

# Este es el proceso que **otorga** permisos: el diálogo donde decís que sí o
# que no a la cámara, al micrófono o a una cuenta. Todo el modelo de seguridad
# del servicio descansa en que sea el único /usr/bin/vasak-permissions-agent
# —por eso el binario está en una ruta que necesita root para escribirse—, y sin
# embargo corría sin una sola restricción, mientras el servicio al que le
# contesta tenía catorce.
#
# Sin red: lo que decidís acá se lo dice al servicio por D-Bus, que es un socket
# local. No hay nada que mandar afuera.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ProtectSystem=full

# De todo /dev ve la placa de video, para dibujar el diálogo, y nada más. Que el
# proceso que te pregunta por la cámara no pueda abrir la cámara es exactamente
# la propiedad que uno quiere acá.
#
# Va con PrivateDevices + BindPaths y no con DeviceAllow porque —comprobado— el
# filtro de dispositivos no se aplica en unidades de usuario: depende de un
# programa BPF que el gestor sin privilegios no puede cargar, así que ahí habría
# quedado de adorno.
PrivateDevices=yes
BindPaths=-/dev/dri

# Quedan afuera MemoryDenyWriteExecute y RestrictNamespaces: el diálogo es una
# ventana Tauri, y WebKit compila su JavaScript en memoria y usa espacios de
# nombres para su propio aislamiento.

[Install]
WantedBy=graphical-session.target
