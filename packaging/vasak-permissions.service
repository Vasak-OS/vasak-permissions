[Unit]
Description=VasakOS permission service
Documentation=https://github.com/Vasak-OS/vasak-permissions
# polkit answers the management calls; without it those would fail.
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=exec
ExecStart=/usr/bin/vasak-permissions
Restart=on-failure
RestartSec=2

# Root is needed to read /proc/<pid>/exe of other users' processes and to own
# the policy files. Everything not needed for that is taken away.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=vasak-permissions
# El servicio escribe los perfiles de excepción de AppArmor, y con
# ProtectSystem=strict todo /etc es de sólo lectura. Se abre ese directorio y
# nada más: es el poder mínimo para que un «permitir» de la configuración
# realmente permita.
ReadWritePaths=/etc/apparmor.d
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
# El servicio sigue el registro del kernel para avisar de lo que los perfiles de
# AppArmor bloquean. `PrivateDevices` le da un /dev propio donde ese archivo no
# existe —comprobado: queda null, zero, random y poco más—, así que se monta el
# único que hace falta, y de sólo lectura.
#
# Con el `-` delante para que el servicio arranque igual en un kernel sin él.
BindReadOnlyPaths=-/dev/kmsg
# Y el permiso, además del montaje: `PrivateDevices` implica
# `DevicePolicy=closed`, así que montar el nodo lo hace visible pero no
# accesible. En una unidad **del sistema** ese filtro sí se aplica —en una de
# usuario no, porque el gestor sin privilegios no puede cargar el programa BPF
# que lo implementa—, y ésta corre como root.
DeviceAllow=/dev/kmsg r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK además de AF_UNIX. Por ahí llegan dos cosas del kernel: el
# conector de procesos, que avisa de cada arranque y es lo que permite nombrar a
# un programa que ya se cerró, y el registro de auditoría, que es de donde salen
# las denegaciones sin pasar por el cupo de `printk`. Netlink no sale del equipo
# —es un canal con el kernel—, así que esto no le abre la red al servicio.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

# No hay `CapabilityBoundingSet` a propósito, y si algún día se agrega tiene que
# dejar `CAP_AUDIT_READ`: es la que permite escuchar el grupo multicast del
# registro de auditoría. Sin ella el `bind` falla con EPERM, el servicio se cae
# al lector de `/dev/kmsg` —que descarta el 96% de los registros, medido— y lo
# único que lo delata es una línea en el diario.
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
# El cortafuegos por aplicación (issue #93) carga un programa eBPF, y para eso
# llama `bpf()`, que `@system-service` NO incluye. La infraestructura (cargar,
# adjuntar, marcar/desmarcar) está en M0 pero todavía **sin llamador en el
# binario** —cablearla a la política es el PR siguiente—, así que el daemon no la
# carga al arrancar por ahora. Esta línea se pre-provisiona igual: cuando el
# cableado la encienda, `bpf()` ya tiene que estar permitido o la carga fallaría
# con EPERM, y queda junto al resto del filtro para no tener que tocar el
# endurecimiento en aquel PR. Las dos directivas `SystemCallFilter` se unen (las
# dos son listas de permitidos), así que esto sólo **suma** `bpf` al conjunto,
# sin abrir nada más.
#
# El resto del endurecimiento se queda tal cual, y no por inercia: la carga BPF
# no pide memoria W^X en el proceso (el JIT es del kernel), así que
# `MemoryDenyWriteExecute=yes` sigue; y adjuntar el programa usa `bpf()`, no un
# socket, así que `RestrictAddressFamilies` tampoco se toca (AF_NETLINK ya está
# para el conector de procesos y el registro de auditoría). Las capacidades
# `CAP_BPF`/`CAP_NET_ADMIN` que la carga necesita ya las tiene root, que es como
# corre esta unidad; si algún día se agrega `CapabilityBoundingSet`, tiene que
# incluir `CAP_BPF CAP_NET_ADMIN` además de `CAP_AUDIT_READ`.
SystemCallFilter=bpf
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
