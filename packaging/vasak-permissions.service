[Unit]
Description=VasakOS permission service
Documentation=https://github.com/Vasak-OS/vasak-permissions
# polkit answers the management calls; without it those would fail.
After=dbus.service polkit.service
Requires=dbus.service

[Service]
Type=exec
ExecStart=/usr/bin/vasak-permissions
Restart=on-failure
RestartSec=2

# Root is needed to read /proc/<pid>/exe of other users' processes and to own
# the policy files. Everything not needed for that is taken away.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=vasak-permissions
# El servicio escribe los perfiles de excepción de AppArmor, y con
# ProtectSystem=strict todo /etc es de sólo lectura. Se abre ese directorio y
# nada más: es el poder mínimo para que un «permitir» de la configuración
# realmente permita.
ReadWritePaths=/etc/apparmor.d
StateDirectoryMode=0700
PrivateTmp=yes
PrivateDevices=yes
# El servicio sigue el registro del kernel para avisar de lo que los perfiles de
# AppArmor bloquean. `PrivateDevices` le da un /dev propio donde ese archivo no
# existe —comprobado: queda null, zero, random y poco más—, así que se monta el
# único que hace falta, y de sólo lectura.
#
# Con el `-` delante para que el servicio arranque igual en un kernel sin él.
BindReadOnlyPaths=-/dev/kmsg
# Y el permiso, además del montaje: `PrivateDevices` implica
# `DevicePolicy=closed`, así que montar el nodo lo hace visible pero no
# accesible. En una unidad **del sistema** ese filtro sí se aplica —en una de
# usuario no, porque el gestor sin privilegios no puede cargar el programa BPF
# que lo implementa—, y ésta corre como root.
DeviceAllow=/dev/kmsg r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK además de AF_UNIX: por ahí llega el conector de procesos del
# kernel, que avisa de cada arranque y es lo que permite nombrar a un programa
# que ya se cerró. Netlink no sale del equipo —es un canal con el kernel—, así
# que esto no le abre la red al servicio.
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
